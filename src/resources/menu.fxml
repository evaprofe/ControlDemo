<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?> 

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="MenuController" 
      spacing="10.0">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <Label text="Menu Demo" textAlignment="CENTER">
        <font>
            <Font size="18.0"/>
        </font>
    </Label>

    <MenuBar>
        <Menu text="File">
            <MenuItem fx:id="newMenuItem" text="New"/>
            <MenuItem fx:id="openMenuItem" text="Open"/>
            <MenuItem fx:id="saveMenuItem" text="Save"/>
            <SeparatorMenuItem/>
            <MenuItem fx:id="exitMenuItem" text="Exit"/>
        </Menu>
        <Menu text="Edit">
            <MenuItem fx:id="cutMenuItem" text="Cut"/>
            <MenuItem fx:id="copyMenuItem" text="Copy"/>
            <MenuItem fx:id="pasteMenuItem" text="Paste"/>
        </Menu>
        <Menu text="Help">
            <MenuItem fx:id="aboutMenuItem" text="About"/>
        </Menu>
    </MenuBar>

    <ToolBar>
        <Button fx:id="btnNew" text="New"/>
        <Button fx:id="btnOpen" text="Open"/>
        <Button fx:id="btnSave" text="Save"/>
        <Separator/>
        <Button fx:id="btnCut" text="Cut"/>
        <Button fx:id="btnCopy" text="Copy"/>
        <Button fx:id="btnPaste" text="Paste"/>
    </ToolBar>

    <Label text="Try the menus and toolbar buttons above!"/>
</VBox>