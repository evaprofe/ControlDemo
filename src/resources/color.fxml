<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ColorController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <Label text="ColorPicker Demostración" textAlignment="CENTER">
        <font>
            <Font size="18.0" />
        </font>
    </Label>
    
    <Label text="Selecciona color:" />
    <ColorPicker fx:id="colorPicker" />
    
    <Button fx:id="applyColorButton" mnemonicParsing="false" text="Aplicar Color" />
    
    <Rectangle fx:id="colorDisplay" height="100.0" stroke="BLACK" strokeType="INSIDE" width="200.0" />
</VBox>
