<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MainController">
    <children>
        <Label layoutX="200.0" layoutY="50.0" text="JavaFX Demostración de Controles" textAlignment="CENTER">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        
        <VBox layoutX="250.0" layoutY="100.0" spacing="20.0">
            <Button fx:id="alertButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="300.0" text="Alertas y Diálogos" />
            <Button fx:id="progressButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="300.0" text="Indicadores de Progresos" />
            <Button fx:id="listButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="300.0" text="Listas y Cajas" />
            <Button fx:id="menuButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="300.0" text="Menus" />
            <Button fx:id="dateButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="300.0" text="Calendario" />
            <Button fx:id="colorButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="300.0" text="Colores" />
            <Button fx:id="mediaButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="300.0" text="Media Player" />
        </VBox>
    </children>
</AnchorPane>
