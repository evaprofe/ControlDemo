<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?> 

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProgressController" spacing="10.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <Label text="Progress Indicators Demo" textAlignment="CENTER">
        <font>
            <Font size="18.0" />
        </font>
    </Label>
    
    <ProgressBar fx:id="progressBar" progress="0.0" />
    <ProgressIndicator fx:id="progressIndicator" progress="0.0" />
    
    <Button fx:id="startButton" mnemonicParsing="false" text="Start Progress" />
    <Button fx:id="resetButton" mnemonicParsing="false" text="Reset Progress" />
</VBox>