<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?> 


<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ColorController" spacing="10.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <Label text="ColorPicker Demo" textAlignment="CENTER">
        <font>
            <Font size="18.0" />
        </font>
    </Label>
    
    <Label text="Select a color:" />
    <ColorPicker fx:id="colorPicker" />
    
    <Button fx:id="applyColorButton" mnemonicParsing="false" text="Apply Color" />
    
    <Rectangle fx:id="colorDisplay" width="200.0" height="100.0" stroke="BLACK" strokeType="INSIDE" />
</VBox>