<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.media.*?>
<?import javafx.geometry.Insets?> 

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MediaController" spacing="10.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <Label text="Media Player Demo" textAlignment="CENTER">
        <font>
            <Font size="18.0" />
        </font>
    </Label>
    
    <MediaView fx:id="mediaView" fitWidth="600.0" fitHeight="400.0" />
    
    <HBox spacing="10.0">
        <Button fx:id="playButton" mnemonicParsing="false" text="Play" />
        <Button fx:id="pauseButton" mnemonicParsing="false" text="Pause" />
        <Button fx:id="stopButton" mnemonicParsing="false" text="Stop" />
    </HBox>
    
    <Slider fx:id="volumeSlider" max="1.0" value="0.5" />
</VBox>