<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?> 

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DateController" spacing="10.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <Label text="DatePicker Demo" textAlignment="CENTER">
        <font>
            <Font size="18.0" />
        </font>
    </Label>
    
    <Label text="Select a date:" />
    <DatePicker fx:id="datePicker" />
    
    <Button fx:id="showDateButton" mnemonicParsing="false" text="Show Date Details" />
    
    <HBox spacing="10.0">
        <Label text="Day:" />
        <Label fx:id="dayLabel" text="-" />
        <Label text="Month:" />
        <Label fx:id="monthLabel" text="-" />
        <Label text="Year:" />
        <Label fx:id="yearLabel" text="-" />
    </HBox>
</VBox>